datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum IdeaStage {
  IDEACAO
  ESCOPO
  PLANO_DE_NEGOCIOS
  DESENVOLVIMENTO
  TESTE_E_VALIDACAO
  LANCAMENTO
}

enum IdeaStatus {
  EM_ANDAMENTO
  EM_REVISAO
  APROVADA
  REJEITADA
}

enum GateDecisionType {
  APROVADA
  REJEITADA
  REVISAO
}

enum UserRole {
  COLLABORATOR
  EVALUATOR
  GESTOR_INOVACAO
  ADMIN
}

enum UserApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Idea {
  id            String       @id @default(uuid())
  title         String       @db.VarChar(255)
  description   String       @db.Text
  author_id     String       @db.VarChar(255)
  extra_fields  Json?        @default("{}")
  current_stage IdeaStage    @default(IDEACAO)
  status        IdeaStatus   @default(EM_ANDAMENTO)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  evaluations   Evaluation[]
  gateDecisions GateDecision[]

  @@map("ideas")
}

model GateDecision {
  id           String           @id @default(uuid())
  ideaId       String
  stage        IdeaStage
  decision     GateDecisionType
  feedback     String           @db.Text
  reviewPoints Json?
  deciderId    String
  createdAt    DateTime         @default(now())
  idea         Idea             @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@map("gate_decisions")
}

model User {
  id             String             @id @default(uuid())
  name           String             @db.VarChar(255)
  email          String             @unique @db.VarChar(255)
  password       String             @db.Text
  role           UserRole           @default(COLLABORATOR)
  approvalStatus UserApprovalStatus @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("users")
}

model Evaluation {
  id            String   @id @default(uuid())
  ideaId        String
  evaluatorId   String
  score         Float
  justification String   @db.Text
  stage         IdeaStage
  criteria      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  idea          Idea     @relation(fields: [ideaId], references: [id], onDelete: Restrict)

  @@index([ideaId])
  @@map("evaluations")
}
