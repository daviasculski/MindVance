datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum IdeaStage {
  IDEACAO
  ESCOPO
  PLANO_DE_NEGOCIOS
  DESENVOLVIMENTO
  TESTE_E_VALIDACAO
  LANCAMENTO
}

enum IdeaStatus {
  AGUARDANDO_TRIAGEM
  AGUARDANDO_DESIGNACAO
  EM_AVALIACAO
  AGUARDANDO_DECISAO
  EM_ANDAMENTO
  EM_REVISAO
  APROVADA
  REJEITADA
}

enum GateDecisionType {
  APROVADA
  REJEITADA
  REVISAO
}

enum GateReviewStatus {
  AGUARDANDO_DESIGNACAO
  EM_AVALIACAO
  AGUARDANDO_DECISAO
  DECIDIDA
}

enum UserRole {
  COLLABORATOR
  EVALUATOR
  GATEKEEPER
  ADMIN
}

enum UserApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Idea {
  id            String         @id @default(uuid())
  title         String         @db.VarChar(255)
  description   String         @db.Text
  author_id     String         @db.VarChar(255)
  extra_fields  Json?          @default("{}")
  current_stage IdeaStage      @default(IDEACAO)
  status        IdeaStatus     @default(EM_ANDAMENTO)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  evaluations   Evaluation[]
  gateDecisions GateDecision[]
  gateReviews   GateReview[]

  @@map("ideas")
}

/// Gate de saída de um estágio. O estágio sem gate de saída (Lançamento) encerra o fluxo.
model Gate {
  id               String          @id @default(uuid())
  orderIndex       Int             @unique
  name             String
  fromStage        IdeaStage       @unique
  toStage          IdeaStage
  deliverable      String
  deadlineDays     Int
  /// score >= approveThreshold → recomenda aprovar
  approveThreshold Float
  /// reviseThreshold <= score < approveThreshold → recomenda revisar; abaixo → rejeitar
  reviseThreshold  Float
  criteria         GateCriterion[]
  reviews          GateReview[]

  @@map("gates")
}

model GateCriterion {
  id          String @id @default(uuid())
  gateId      String
  name        String
  description String
  weight      Int
  orderIndex  Int
  gate        Gate   @relation(fields: [gateId], references: [id], onDelete: Restrict)

  @@unique([gateId, orderIndex])
  @@map("gate_criteria")
}

/// Uma rodada de avaliação de uma ideia em um gate. Revisar abre uma nova rodada no mesmo gate.
model GateReview {
  id                String                @id @default(uuid())
  ideaId            String
  gateId            String
  round             Int
  status            GateReviewStatus      @default(AGUARDANDO_DESIGNACAO)
  requestedById     String
  openedAt          DateTime              @default(now())
  deadlineAt        DateTime?
  consolidatedScore Float?
  recommendation    GateDecisionType?
  idea              Idea                  @relation(fields: [ideaId], references: [id], onDelete: Restrict)
  gate              Gate                  @relation(fields: [gateId], references: [id], onDelete: Restrict)
  evaluators        GateReviewEvaluator[]
  evaluations       Evaluation[]
  decision          GateDecision?

  @@unique([ideaId, gateId, round])
  @@index([status])
  @@map("gate_reviews")
}

model GateReviewEvaluator {
  id           String     @id @default(uuid())
  reviewId     String
  evaluatorId  String
  assignedById String
  assignedAt   DateTime   @default(now())
  review       GateReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  @@unique([reviewId, evaluatorId])
  @@index([evaluatorId])
  @@map("gate_review_evaluators")
}

/// Transição registrada a cada decisão do Gestor (equivale a stage_transitions). Imutável.
model GateDecision {
  id                String            @id @default(uuid())
  ideaId            String
  reviewId          String?           @unique
  stage             IdeaStage
  toStage           IdeaStage?
  decision          GateDecisionType
  recommendation    GateDecisionType?
  consolidatedScore Float?
  feedback          String            @db.Text
  reviewPoints      Json?
  deciderId         String
  createdAt         DateTime          @default(now())
  idea              Idea              @relation(fields: [ideaId], references: [id], onDelete: Restrict)
  review            GateReview?       @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  @@index([ideaId])
  @@map("gate_decisions")
}

model User {
  id             String             @id @default(uuid())
  name           String             @db.VarChar(255)
  email          String             @unique @db.VarChar(255)
  password       String             @db.Text
  role           UserRole           @default(COLLABORATOR)
  approvalStatus UserApprovalStatus @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("users")
}

model Evaluation {
  id            String      @id @default(uuid())
  ideaId        String
  evaluatorId   String
  score         Float
  justification String      @db.Text
  stage         IdeaStage
  criteria      Json?
  reviewId      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  idea          Idea        @relation(fields: [ideaId], references: [id], onDelete: Restrict)
  review        GateReview? @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  @@unique([reviewId, evaluatorId])
  @@index([ideaId])
  @@map("evaluations")
}
